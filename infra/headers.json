{
  "document": {
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp"
  },
  "immutable": {
    "Cache-Control": "public, max-age=31536000, immutable"
  },
  "revalidate": {
    "Cache-Control": "no-cache"
  },
  "immutablePagePaths": [
    "assets/*"
  ],
  "revalidatePagePaths": [
    "",
    "index.html"
  ],
  "revalidateEnginePaths": [
    "vendor/supersonic/manifest.json",
    "vendor/supersonic/wasm/*",
    "vendor/supersonic/workers/*",
    "vendor/supersonic/synthdefs/*",
    "vendor/supersonic/samples/*"
  ],
  "revalidateSharedPaths": [
    "*"
  ]
}
