{
  "name": "ss-play",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Web pages running SuperCollider's scsynth in the browser via SuperSonic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohla/SS_Play.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf apps/*/dist packages/*/dist node_modules/.vite sidecar/out"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
