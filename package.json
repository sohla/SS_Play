{
  "name": "ss-play",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Web pages running SuperCollider's scsynth in the browser via SuperSonic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sohla/SS_Play.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "sidecar"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @ss/playground",
    "dev:landing": "npm run dev -w @ss/landing",
    "dev:scratch": "npm run dev -w @ss/scratch",
    "build": "npm run build --workspaces --if-present && node tools/assemble.mjs",
    "assemble": "node tools/assemble.mjs",
    "preview": "node tools/serve.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "infra:gen": "node infra/gen.mjs",
    "infra:check": "node infra/gen.mjs --check",
    "deploy": "node infra/deploy.mjs",
    "samples": "node infra/samples.mjs",
    "e2e": "playwright test",
    "verify": "npm run infra:check && npm run typecheck && npm test && npm run build && npm run e2e",
    "clean": "rm -rf dist apps/*/dist packages/*/dist node_modules/.vite sidecar/out",
    "dev:lan": "SS_LAN=1 npm run dev -w @ss/playground",
    "sc:build": "npm run build -w @ss/sidecar",
    "sc:test": "npm run test -w @ss/sidecar",
    "sc:manifest": "npm run manifest -w @ss/sidecar",
    "sc:promote": "npm run promote -w @ss/sidecar",
    "survey": "node tools/ugen-survey.mjs",
    "sc:verify": "npm run sc:build && npm run sc:test && npm run sc:continuity && npm run sc:manifest",
    "sc:live": "npm run live -w @ss/sidecar --",
    "sc:continuity": "npm run continuity -w @ss/sidecar",
    "listen": "node tools/listen.mjs",
    "infer-contracts": "node tools/infer-contracts.mjs",
    "unknown-params": "node tools/unknown-params.mjs"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
